<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO"/>
    <!-- anchors the map on the real vehicle position instead of a hardcoded origin -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <permission
        android:name="com.swapnil.smart.aaos.PLAY_SONG"
        android:protectionLevel="signature" />
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <uses-feature
        android:name="android.software.car.templates_host"
        android:required="true" />


    <!--
      Vehicle data permissions, grouped by protection level as declared by
      com.android.car.updatable on AAOS API 35. The level decides what the app
      has to do to actually get the data, so it is worth being explicit:

        normal     -> granted at install, nothing else to do.
        dangerous  -> runtime permission; must be requested via
                      CarContext.requestPermissions(). NOTE: on AAOS the driver
                      is user 10, so an adb grant must pass the user flag
                      explicitly or it silently targets user 0.
        privileged -> only granted to apps in /system/priv-app that are also
                      named in a privapp-permissions allowlist XML. A normal
                      APK install can never hold these, by design.
    -->

    <!-- normal: INFO_MAKE / INFO_MODEL / INFO_MODEL_YEAR / INFO_FUEL_CAPACITY -->
    <uses-permission android:name="android.car.permission.CAR_INFO" />
    <!-- normal: CURRENT_GEAR / GEAR_SELECTION / IGNITION_STATE / PARKING_BRAKE_ON -->
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />

    <!-- dangerous: PERF_VEHICLE_SPEED -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <!-- dangerous: FUEL_LEVEL / EV_BATTERY_LEVEL -->
    <uses-permission android:name="android.car.permission.CAR_ENERGY" />

    <!-- privileged: ENGINE_RPM -->
    <uses-permission android:name="android.car.permission.CAR_ENGINE_DETAILED" />
    <!-- privileged: PERF_ODOMETER -->
    <uses-permission android:name="android.car.permission.CAR_MILEAGE" />
    <!-- privileged: INFO_VIN -->
    <uses-permission android:name="android.car.permission.CAR_IDENTIFICATION" />
    <!-- privileged: every custom vendor property (see VendorProperties.kt) -->
    <uses-permission android:name="android.car.permission.CAR_VENDOR_EXTENSION" />

    <!-- Navigation/map template capabilities (car-app 1.7.0) -->
    <uses-permission android:name="androidx.car.app.NAVIGATION_TEMPLATES" />
    <uses-permission android:name="androidx.car.app.MAP_TEMPLATES" />
    <uses-permission android:name="androidx.car.app.ACCESS_SURFACE" />

    <application
        android:label="Smart AAOS"
        android:icon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="2" />

        <activity
            android:name="androidx.car.app.activity.CarAppActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- ✅ THIS IS THE KEY FIX -->
            <meta-data
                android:name="androidx.car.app.CarAppService"
                android:value=".car.SmartCarAppService" />

        </activity>
        <service
            android:name=".vehicle.VehicleDataService"
            android:exported="true"
            android:permission="com.swapnil.smart.aaos.PLAY_SONG">
            <intent-filter>
                <action android:name="com.swapnil.smart.aaos.IVehicleDataService" />
            </intent-filter>
        </service>
        <service
            android:name=".car.SmartCarAppService"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.MEDIA" />
            </intent-filter>
        </service>

        <service
            android:name=".media.SmartMusicService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.media.browse.MediaBrowserService.VERSION"
                android:value="1" />
        </service>
        <receiver android:name="androidx.media.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

    </application>

</manifest>